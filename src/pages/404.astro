---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CALCULATORS } from '../data/calculators';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다." noindex>
  <div class="py-10 text-center">
    <p class="text-5xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">페이지를 찾을 수 없습니다</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">주소가 바뀌었거나 삭제된 페이지일 수 있습니다.</p>
    <a href="/" class="mt-6 inline-block rounded-xl bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">홈으로 가기</a>
  </div>
  <ul class="mx-auto mt-6 grid max-w-lg gap-2">
    {CALCULATORS.map((c) => <li><a class="card block !p-4 hover:border-brand-500" href={`/${c.slug}/`}>{c.icon} {c.title}</a></li>)}
  </ul>
</BaseLayout>
