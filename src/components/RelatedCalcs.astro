---
import { getCalculator } from '../data/calculators';

interface Props {
  slugs: string[];
}
const calcs = Astro.props.slugs.map(getCalculator);
---

<section aria-labelledby="related-title" class="mt-14">
  <h2 id="related-title" class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-50">함께 쓰면 좋은 계산기</h2>
  <ul class="grid gap-3 sm:grid-cols-3">
    {
      calcs.map((c) => (
        <li>
          <a href={`/${c.slug}/`} class="card flex h-full flex-col gap-1 !p-4 transition hover:border-brand-500">
            <span class="text-2xl" aria-hidden="true">{c.icon}</span>
            <span class="font-semibold text-slate-900 dark:text-slate-100">{c.title}</span>
            <span class="text-sm leading-6 text-slate-600 dark:text-slate-400">{c.summary}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
