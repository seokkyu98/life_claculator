---
import { SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
      <svg aria-hidden="true" width="26" height="26" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#2f6fed"></rect><path d="M9 11h14M9 16h6m-6 5h6m4-5h4m-2-2v4m-2 3.5h4" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path></svg>
      {SITE.name}
    </a>
    <ThemeToggle />
  </div>
</header>
