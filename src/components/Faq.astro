---
export interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<section aria-labelledby="faq-title" class="mt-14">
  <h2 id="faq-title" class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-50">자주 묻는 질문</h2>
  <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white dark:divide-slate-800 dark:border-slate-800 dark:bg-slate-900">
    {
      items.map((item) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-slate-900 dark:text-slate-100 [&::-webkit-details-marker]:hidden">
            <h3 class="text-base">{item.q}</h3>
            <span aria-hidden="true" class="mt-0.5 text-slate-400 transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-7 text-slate-700 dark:text-slate-300">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
