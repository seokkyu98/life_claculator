---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Breadcrumb items={[{ name: '홈', href: '/' }, { name: title }]} />
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{title}</h1>
  <div class="prose-ko mt-6">
    <slot />
  </div>
</BaseLayout>
